#!/bin/bash
# helm — talk to your own conductor from inside the shell.
#
# Sends a prompt to the Worker's /conductor/message endpoint authenticated
# via HELM_INTERNAL_TOKEN (a Worker secret forwarded into the container by
# ShellContainerDO.envVars), and prints the assistant's reply.
#
# Examples:
#   helm "what plugins are enabled?"
#   helm "create a D1 database called helm-pa, then put its uuid in KV"
#   helm --plan "what would you do to set up Cloudflare Access?"
#
# Env required (set as Worker secrets, forwarded automatically):
#   HELM_WORKER_HOST     e.g. helm.example.workers.dev (no scheme)
#   HELM_INTERNAL_TOKEN  matches env.HELM_INTERNAL_TOKEN on the Worker
#
# This is intentionally a curl one-liner — no Node deps, no auth juggling.
# When the agent in the shell wants to operate Cloudflare, it does so by
# *calling itself* through this command, which is the same path the
# browser /chat tab uses.

set -e

MODE="execute"
if [ "${1:-}" = "--plan" ]; then MODE="plan"; shift; fi
if [ "${1:-}" = "--help" ] || [ -z "${1:-}" ]; then
  cat <<'USAGE'
helm — send a prompt to the conductor and print the response.

Usage:
  helm "<prompt>"            run in execute mode (uses tools)
  helm --plan "<prompt>"     run in plan mode (describes only, no tools)

Required env (set as Worker secrets — auto-forwarded into this container):
  HELM_WORKER_HOST       worker hostname (no scheme), e.g. helm.example.workers.dev
  HELM_INTERNAL_TOKEN    bearer token matching env.HELM_INTERNAL_TOKEN

Tip: pipe long prompts via stdin, e.g.
  cat plan.md | helm "$(cat)"
USAGE
  exit 0
fi

if [ -z "${HELM_WORKER_HOST:-}" ]; then
  echo "helm: HELM_WORKER_HOST not set — set it as a Worker secret." >&2
  exit 2
fi
if [ -z "${HELM_INTERNAL_TOKEN:-}" ]; then
  echo "helm: HELM_INTERNAL_TOKEN not set — set it as a Worker secret with:" >&2
  echo "  wrangler secret put HELM_INTERNAL_TOKEN" >&2
  exit 2
fi

PROMPT="$*"
SESSION="${HELM_SESSION:-shell-cli}"
PAYLOAD="$(jq -n --arg c "$PROMPT" --arg s "$SESSION" --arg m "$MODE" \
  '{content:$c, sessionName:$s, mode:$m}')"

RESPONSE="$(curl -fsS \
  -X POST \
  -H "content-type: application/json" \
  -H "Authorization: Bearer ${HELM_INTERNAL_TOKEN}" \
  --data "$PAYLOAD" \
  "https://${HELM_WORKER_HOST}/conductor/message" 2>&1)" || {
  echo "helm: request failed: $RESPONSE" >&2
  exit 1
}

# Print the assistant's text. Fall back to dumping the whole JSON if we
# can't extract it (so the user can debug).
TEXT="$(echo "$RESPONSE" | jq -r '.assistantMessage.content // empty' 2>/dev/null || true)"
if [ -n "$TEXT" ]; then
  echo "$TEXT"
else
  echo "$RESPONSE"
fi
