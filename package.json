{
  "name": "tom-tom",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:bootstrap": "node ./scripts/cf_bootstrap.mjs",
    "tomtom:deploy": "node ./scripts/deploy_tomtom.mjs",
    "cf:bootstrap:sh": "./scripts_setup.sh",
    "cf:smoke": "node ./scripts/cf_smoke.mjs",
    "cf:mcp:config": "node ./scripts/cf_mcp_config.mjs",
    "plugin:new": "node ./scripts/create_plugin.mjs",
    "vapid:generate": "node ./scripts/generate_vapid_keys.mjs",
    "pa:setup": "node ./scripts/pa_setup.mjs"
  },
  "cloudflare": {
    "_comment": "Intentionally empty so the Deploy to Cloudflare button shows a clean form. Optional secrets (ANTHROPIC_API_KEY, CLOUDFLARE_API_TOKEN, etc.) are documented in docs/PROVIDERS.md and added by the user post-deploy via dash → Worker → Settings → Variables, or via wrangler secret put. Workers AI is bound by default — the agent runs immediately without any secrets."
  },
  "dependencies": {
    "jose": "^5.9.6",
    "postal-mime": "^2.4.3",
    "mimetext": "^3.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260403.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.11.1"
  }
}
